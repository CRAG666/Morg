{
  "theme": "eyes",
  "load": {
    "core.concealer": {
      "config": {
        "icon_preset": "basic",
        "icons": {
          "code_block": { "conceal": true },
          "delimiter": { "horizontal_line": { "icon": "━" } },
          "definition": {
            "single": { "icon": "🔖 " },
            "multi_prefix": { "icon": "󰉾 " },
            "multi_suffix": { "icon": "󰝗 " }
          },
          "list": { "icons": ["✿"] },
          "quote": { "icons": ["󰇙"] },
          "heading": { "icons": ["🌸 ", "🌼 ", "🌺 ", "💠 ", "💮 ", "🪷 "] }
        }
      }
    },
    "core.esupports.metagen": {
      "config": { "author": "think-crag" }
    },
    "core.journal": {
      "config": { "journal_folder": "journal", "strategy": "nested" }
    },
    "core.dirman": {
      "config": {
        "workspaces": {
          "life": "~/Documents/Org/Life/",
          "work": "~/Documents/Org/Work/",
          "master": "~/Documents/Projects/Postgraduate_studies/Master/Notes/",
          "phd": "~/Documents/Projects/Postgraduate_studies/PhD/Notes/",
          "lectures": "~/Documents/Projects/Postgraduate_studies/lectures"
        }
      }
    }
  }
}
